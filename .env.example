# Copy to .env and fill in. NEVER commit .env.
# D4: no credentials, endpoints or model identifiers belong in the repository.

# ---- LLM provider ----
# Local stub defaults work without credentials. To use a hosted OpenAI-compatible provider,
# set its base URL, model, API key, and input/output rates in your private .env.
LLM_BASE_URL=http://stub-llm:8000
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
LLM_INPUT_USD_PER_1M=
LLM_OUTPUT_USD_PER_1M=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3
LLM_BACKOFF_BASE_SECONDS=1.0
BREAKER_FAILURE_THRESHOLD=5
BREAKER_COOLDOWN_SECONDS=30
STUB_DELAY_SECONDS=2.0
STUB_FAIL_RATE=0

# ---- Infrastructure wiring (docker network names) ----
REDIS_URL=redis://redis:6379/0
DATABASE_URL=postgresql://triage:change-me@postgres:5432/triage
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-me
POSTGRES_DB=triage
CHROMA_HOST=chroma
CHROMA_PORT=8000
RETRIEVAL_URL=http://retrieval:8000
VERIFIER_URL=http://verifier:8000

# ---- Retrieval ----
# Set to a sentence-transformers model name when you reach Stage 1.
EMBEDDING_MODEL=
CORPUS_DIR=/corpus

# ---- Agent limits (A1) ----
MAX_AGENT_STEPS=8
MAX_TOOL_CALLS=12
RUN_TIMEOUT_SECONDS=90

# ---- API ----
SCHEMA_DIR=/schemas
RATE_LIMIT_PER_MINUTE=30
CORS_ORIGINS=http://localhost:8080
PROMPT_VERSION=v1
