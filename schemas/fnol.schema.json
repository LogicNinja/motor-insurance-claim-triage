{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fnol.schema.json",
  "title": "FNOL",
  "description": "First Notice of Loss submitted to POST /claims.",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_number", "date_of_loss", "vehicle_registration", "description"],
  "properties": {
    "policy_number": {"type": "string", "minLength": 5, "maxLength": 40, "pattern": "^[A-Za-z0-9/-]+$"},
    "date_of_loss": {"type": "string", "format": "date"},
    "time_of_loss": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "vehicle_registration": {"type": "string", "pattern": "^[A-Z]{2}[0-9]{1,2}[A-Z]{1,3}[0-9]{4}$"},
    "description": {"type": "string", "minLength": 10, "maxLength": 2000},
    "location": {"type": "string", "maxLength": 300},
    "vehicle_status": {"enum": ["parked", "moving"]},
    "driven_by": {"enum": ["owner", "other"]},
    "third_party_injury": {"type": "boolean"},
    "fir_lodged": {"type": "boolean"},
    "fir_number": {"type": "string", "maxLength": 40},
    "estimated_damage_inr": {"type": "integer", "minimum": 0, "maximum": 10000000},
    "claim_type_hint": {"enum": ["own_damage", "third_party", "theft", "total_loss"]}
  }
}
